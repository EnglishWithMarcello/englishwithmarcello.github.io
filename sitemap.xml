  {%- for post in site.blog %}
  {%- assign key = post.translationKey | default: post.ref %}
  {%- assign sib = nil %}
  {%- if key and key != "" %}
  {%- assign sib = site.blog | where:"translationKey", key | where_exp:"i","i.lang != post.lang" | first %}
  {%- unless sib %}{%- assign sib = site.blog | where:"ref", key | where_exp:"i","i.lang != post.lang" | first %}{%- endunless %}
  {%- endif %}
  {%- if post.lang == 'en' %}{%- assign en = post.url %}{%- assign it = sib.url %}{%- else %}{%- assign it = post.url %}{%- assign en = sib.url %}{%- endif %}
  <url>
    <loc>{{ post.url | absolute_url }}</loc>
    {%- if en %}
    <xhtml:link rel="alternate" hreflang="en" href="{{ en | absolute_url }}"/>{%- endif %}
    {%- if it %}
    <xhtml:link rel="alternate" hreflang="it" href="{{ it | absolute_url }}"/>{%- endif %}
    {%- if en %}
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ en | absolute_url }}"/>{%- endif %}
    <lastmod>{{ post.date | date: "%Y-%m-%d" }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  {%- endfor %}
